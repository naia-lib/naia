#!/usr/bin/env bash
# naia push gate — tracked source. Install once per clone:
#   git config core.hooksPath tools/hooks
# (per-worktree instead: git config --worktree core.hooksPath tools/hooks)
# Legs: rustfmt drift check first, then warning-clean native + wasm32 checks.
# Verify linux-native + wasm32-unknown-unknown builds before every push.
# As of T2.4 (2026-05-05) the workspace is warning-clean. We gate the
# native build with `RUSTFLAGS="-D warnings"` so any regression fails
# the push instead of silently piling up. The wasm32 checks stay on
# `cargo check` (faster than full build) but also gate on warnings.
set -e

# Main is FROZEN. Naia is the exception to the Factory Operating Procedure:
# naia `main` moves ONLY on Connor's explicit word — never on coordinator
# direction, never on seam-closure logic, never fast-forward, never for any
# reason. The hook therefore refuses EVERY update of refs/heads/main,
# including fast-forwards: no push process, qualification, or release flow
# constitutes authority to move main. If Connor orders a main move, he moves
# it himself or names the exact sha in writing; this hook is then bypassed
# only by his explicit word for that push, never edited to re-bless automation.
while read local_ref local_sha remote_ref remote_sha; do
    if [[ "$remote_ref" == "refs/heads/main" ]]; then
        echo "[pre-push] ERROR: Every push to 'main' is forbidden."
        echo "[pre-push] Naia main moves ONLY on Connor's explicit word."
        echo "[pre-push] No coordinator, seam rule, or release flow is authority."
        exit 1
    fi
done

echo "[pre-push] cargo fmt --all --check (no rustfmt drift)..."
cargo fmt --all --check

echo "[pre-push] cargo check --workspace --all-targets (warning-clean gate)..."
RUSTFLAGS="-D warnings" cargo check --workspace --all-targets --quiet

echo "[pre-push] cargo check -p naia-shared --target wasm32-unknown-unknown..."
RUSTFLAGS="-D warnings" cargo check -p naia-shared --target wasm32-unknown-unknown --features wbindgen --quiet

echo "[pre-push] cargo check -p naia-client --target wasm32-unknown-unknown..."
RUSTFLAGS="-D warnings" cargo check -p naia-client --target wasm32-unknown-unknown --features wbindgen --quiet

echo "[pre-push] cargo check -p naia-bevy-client --target wasm32-unknown-unknown..."
RUSTFLAGS="-D warnings" cargo check -p naia-bevy-client --target wasm32-unknown-unknown --quiet

echo "[pre-push] cargo clippy mquad socket backend --target wasm32-unknown-unknown..."
cargo clippy -p naia-socket-shared -p naia-client-socket --target wasm32-unknown-unknown --features mquad --quiet -- -D warnings

echo "[pre-push] all checks passed."
